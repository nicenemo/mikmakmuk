{% set tiers = tests | map(attribute='tier') | unique | list %}
| Path |{% for tier in tiers %} {{ tier }} (Gbps) | {{ tier }} retransmits |{% endfor %}

| :--- |{% for tier in tiers %} ---: | ---: |{% endfor %}

{% for source in hosts %}
{% for target in benchmark_hosts if target != source %}
{% set row = namespace(text='| ' ~ source ~ ' → ' ~ target ~ ' |') %}
{% for tier in tiers %}
{% set hit = tests | selectattr('tier', 'equalto', tier) | selectattr('source', 'equalto', source)
                    | selectattr('target', 'equalto', target) | first | default({}) %}
{% set row.text = row.text ~ ' ' ~ m.fmt(hit.received_gbps | default(none), {'precision': 2}) ~ ' |' %}
{% set row.text = row.text ~ ' ' ~ m.fmt(hit.retransmits | default(none), {'precision': 0}) ~ ' |' %}
{% endfor %}
