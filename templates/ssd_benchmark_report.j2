=========================================================================
    CLUSTER BASE DISK I/O PERFORMANCE, HARDWARE & THERMAL MATRIX
=========================================================================
{% for host in groups['cluster_nodes'] %}
{% set m = hostvars[host].get('node_ssd_metrics', {}) %}
NODE: {{ host.upper() }}
  SSD Model                : {{ m.drive_model | default('N/A') }}
  Wear & Endurance Status  : {{ m.wear_pct | default('N/A') }} Wear | {{ m.tbw_written | default('N/A') }} Written
  NVMe Thermal Delta       : {{ m.temp_before | default('N/A') }} °C (Idle)  -->  {{ m.temp_after | default('N/A') }} °C (Post-Test)
  Direct Sequential Write  : {{ m.seq_write_mbs | default('N/A') }} MB/s ({{ m.seq_iops | default('N/A') }} IOPS)
  fsync Random Write       : {{ m.sync_write_mbs | default('N/A') }} MB/s ({{ m.sync_iops | default('N/A') }} IOPS)
  fsync Latency (Avg / p99): {{ m.fsync_lat_avg_us | default('N/A') }} µs / {{ m.fsync_lat_p99_us | default('N/A') }} µs
  Btrfs Trim Recommendation: {{ m.trim_recommendation | default('N/A') }}
-------------------------------------------------------------------------
{% endfor %}
=========================================================================
