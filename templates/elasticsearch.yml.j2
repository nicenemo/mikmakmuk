# ======================== Cluster & Node ========================
cluster.name: homelab-cluster
node.name: {{ inventory_hostname }}

# ========================== Network =============================
# Inter-node transport traffic strictly on the 2.5 GbE USB network
transport.host: "{{ cluster_ip }}"
transport.port: 9300

# REST API listening strictly on loopback and the designated management IP
http.host:
  - "127.0.0.1"
  - "{{ elasticsearch_ip }}"
http.port: 9200

# ================= **Discovery & Seed Nodes** ===================
discovery.seed_hosts:
{% for host in groups['cluster_nodes'] %}
{% if 'elasticsearch_node' in (hostvars[host]['cluster_roles'] | default([])) %}
  - "{{ hostvars[host]['cluster_ip'] }}:9300"
{% endif %}
{% endfor %}

{# Injected only if the playbook detects an uninitialized data directory #}
{% if not node_is_bootstrapped %}
cluster.initial_master_nodes:
{% for host in groups['cluster_nodes'] %}
{% if 'elasticsearch_node' in (hostvars[host]['cluster_roles'] | default([])) %}
  - "{{ host }}"
{% endif %}
{% endfor %}
{% endif %}

# ======================= Licensing & Security ===================
xpack.license.self_generated.type: {{ es_license_type | default(lookup('env', 'ES_LICENSE_TYPE') | default('basic', true)) }}

xpack.security.enabled: true
xpack.security.enrollment.enabled: false

# Transport SSL (Node-to-Node communication over 192.168.107.x)
xpack.security.transport.ssl:
  enabled: true
  verification_mode: certificate
  key: /etc/elasticsearch/certs/{{ inventory_hostname }}.key
  certificate: /etc/elasticsearch/certs/{{ inventory_hostname }}.crt
  certificate_authorities: [ "/etc/elasticsearch/certs/ca.crt" ]

# HTTP SSL (Client REST API communication)
xpack.security.http.ssl:
  enabled: true
  key: /etc/elasticsearch/certs/{{ inventory_hostname }}.key
  certificate: /etc/elasticsearch/certs/{{ inventory_hostname }}.crt
  certificate_authorities: [ "/etc/elasticsearch/certs/ca.crt" ]
