---
# yamllint configuration aligned with .editorconfig / .prettierrc (120 columns)
# and with the settings ansible-lint requires for compatibility.
extends: default

ignore-from-file: .gitignore

rules:
  line-length:
    max: 120
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  braces:
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
